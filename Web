<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>YOU FOUND IT</title>

<style>

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    background: #050505;
    color: white;
    font-family: monospace;
    overflow-x: hidden;
}

/* scanlines */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 100;
    opacity: 0.06;

    background: repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 3px,
        white 4px
    );
}

/* glow */

.glow {
    position: fixed;

    width: 500px;
    height: 500px;

    background: white;

    border-radius: 50%;

    filter: blur(180px);

    opacity: 0.07;

    left: 50%;
    top: 30%;

    transform: translate(-50%, -50%);

    pointer-events: none;
}

/* main */

main {
    width: 90%;
    max-width: 1000px;

    margin: auto;
}

/* nav */

nav {
    display: flex;
    justify-content: space-between;

    padding-top: 30px;

    font-size: 13px;

    color: #777;
}

.logo {
    color: white;
    letter-spacing: 5px;
}

.online {
    color: #777;
}

.online span {
    color: white;
}

/* hero */

.hero {
    min-height: 85vh;

    display: flex;
    flex-direction: column;

    justify-content: center;
}

.small {
    color: #666;

    letter-spacing: 4px;

    font-size: 11px;

    margin-bottom: 25px;
}

h1 {
    font-size: clamp(60px, 14vw, 150px);

    line-height: 0.8;

    letter-spacing: -8px;

    margin: 0;
}

.subtitle {
    color: #888;

    max-width: 550px;

    line-height: 1.7;

    margin-top: 35px;

    font-size: 15px;
}

/* buttons */

.buttons {
    display: flex;

    gap: 12px;

    margin-top: 30px;

    flex-wrap: wrap;
}

.button {
    padding: 14px 20px;

    border: 1px solid #333;

    background: #090909;

    color: white;

    text-decoration: none;

    font-family: monospace;

    cursor: pointer;

    transition: 0.2s;
}

.button:hover {
    background: white;

    color: black;

    border-color: white;

    transform: translateY(-3px);
}

/* sections */

section {
    border-top: 1px solid #222;

    padding: 70px 0;
}

.section-title {
    color: #666;

    letter-spacing: 4px;

    font-size: 11px;

    margin-bottom: 25px;
}

/* cards */

.cards {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 12px;
}

.card {
    background: #090909;

    border: 1px solid #222;

    padding: 25px;

    min-height: 180px;

    transition: 0.25s;
}

.card:hover {
    transform: translateY(-6px);

    border-color: #777;
}

.card-number {
    color: #444;

    font-size: 11px;
}

.card h2 {
    margin-top: 45px;

    font-size: 19px;
}

.card p {
    color: #777;

    font-size: 12px;

    line-height: 1.7;
}

/* terminal */

.terminal {
    background: #080808;

    border: 1px solid #222;

    padding: 25px;

    color: #777;

    line-height: 2;
}

.green {
    color: #aaa;
}

/* secret */

.secret {
    text-align: center;

    padding: 100px 20px;
}

.secret h2 {
    font-size: 35px;

    margin-bottom: 15px;
}

.secret p {
    color: #666;
}

/* footer */

footer {
    text-align: center;

    padding: 60px 0;

    color: #333;

    font-size: 11px;
}

/* mobile */

@media (max-width: 700px) {

    h1 {
        letter-spacing: -5px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

}

</style>

</head>

<body>

