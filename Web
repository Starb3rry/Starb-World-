<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>YOU FOUND IT</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: #050505;
            color: white;
            font-family: monospace;
            overflow-x: hidden;
        }

        /* Scanline effect */
        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 999;
            opacity: 0.07;
            background: repeating-linear-gradient(
                0deg,
                transparent 0px,
                transparent 3px,
                white 4px
            );
        }

        /* Background glow */
        .glow {
            position: fixed;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: white;
            filter: blur(150px);
            opacity: 0.08;
            left: 50%;
            top: 30%;
            transform: translate(-50%, -50%);
            pointer-events: none;
        }

        main {
            width: 90%;
            max-width: 950px;
            margin: auto;
        }

        /* NAVIGATION */

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 30px;
            margin-bottom: 80px;
            font-size: 13px;
        }

        .logo {
            letter-spacing: 5px;
        }

        .status {
            color: #777;
        }

        .status span {
            color: white;
        }

        /* HERO */

        .hero {
            min-height: 70vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .eyebrow {
            color: #666;
            font-size: 12px;
            letter-spacing: 4px;
            margin-bottom: 20px;
        }

        h1 {
            font-size: clamp(55px, 13vw, 125px);
            line-height: 0.82;
            letter-spacing: -7px;
            margin: 0 0 30px;
        }

        .description {
            max-width: 600px;
            color: #888;
            line-height: 1.7;
            font-size: 15px;
        }

        /* BUTTONS */

        .buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .button {
            display: inline-block;
            padding: 14px 20px;
            border: 1px solid #333;
            background: #090909;
            color: white;
            text-decoration: none;
            font-family: monospace;
            cursor: pointer;
            transition: 0.2s;
        }

        .button:hover {
            background: white;
            color: black;
            border-color: white;
            transform: translateY(-3px);
        }

        /* SECTIONS */

        section {
            border-top: 1px solid #222;
            padding: 60px 0;
        }

        /* CARDS */

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
        }

        .card {
            min-height: 160px;
            padding: 22px;
            border: 1px solid #222;
            background: #090909;
            transition: 0.2s;
        }

        .card:hover {
            border-color: #777;
            transform: translateY(-4px);
        }

        .number {
            color: #555;
            font-size: 11px;
        }

        .card h2 {
            font-size: 18px;
            margin-top: 35px;
            margin-bottom: 10px;
        }

        .card p {
            color: #777;
            font-size: 12px;
            line-height: 1.6;
        }

        /* TERMINAL */

        .terminal {
            border: 1px solid #222;
            background: #090909;
            padding: 22px;
            line-height: 2;
            color: #888;
        }

        .terminal .prompt {
            color: white;
        }

        /* FOOTER */

        footer {
            text-align: center;
            padding: 50px 0;
            color: #444;
            font-size: 11px;
        }

        /* MOBILE */

        @media (max-width: 650px) {

            nav {
                margin-bottom: 40px;
            }

            h1 {
                letter-spacing: -4px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .hero {
                min-height: 75vh;
            }
        }
    </style>
</head>

<body>

    <div class="glow"></div>

    <main>

        <!-- NAV -->

        <nav>
            <div class="logo">
                A//01
            </div>

            <div class="status">
                ● <span>ONLINE</span>
            </div>
        </nav>


        <!-- HERO -->

        <div class="hero">

            <div class="eyebrow">
                A RANDOM CORNER OF THE INTERNET
            </div>

            <h1>
                YOU<br>
                FOUND<br>
                IT.
            </h1>

            <p class="description">
                There isn't supposed to be anything here.<br>
                But since you're here... welcome.
            </p>

            <div class="buttons">

                <a class="button" href="#archive">
                    ENTER →
                </a>

                <button class="button" onclick="alert('okay. you clicked it. 😭')">
                    DON'T CLICK
                </button>

            </div>

        </div>


        <!-- ARCHIVE -->

        <section id="archive">

            <div class="eyebrow">
                01 / ARCHIVE
            </div>

            <div class="cards">

                <div class="card">

                    <div class="number">
                        01
                    </div>

                    <h2>
                        GAMES
                    </h2>

                    <p>
                        Things I play.
                        Things I probably play too much.
                    </p>

                </div>


                <div class="card">

                    <div class="number">
                        02
                    </div>

                    <h2>
                        RANDOM
                    </h2>

                    <p>
                        Images, links, thoughts
                        and other internet debris.
                    </p>

                </div>


                <div class="card">

                    <div class="number">
                        03
                    </div>

                    <h2>
                        SECRET
                    </h2>

                    <p>
                        There may or may not be
                        something hidden here.
                    </p>

                </div>

            </div>

        </section>


        <!-- TERMINAL -->

        <section>

            <div class="eyebrow">
                02 / TERMINAL
            </div>

            <div class="terminal">

                <span class="prompt">
                    guest@internet:~$
                </span>
                whoami

                <br>

                anonymous visitor

                <br>

                <span class="prompt">
                    guest@internet:~$
                </span>
                status

                <br>

                you found the website

                <br>

                <span class="prompt">
                    guest@internet:~$
                </span>
                _

            </div>

        </section>


        <!-- FOOTER -->

        <footer>
            made for the curious · A//01
        </footer>

    </main>

</body>
</html>
